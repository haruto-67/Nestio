# docker-compose.yml の env_file として読み込む本番用の環境変数。
# コピーして .env を作り、実際の値を埋める（.env はコミットしない。CLAUDE.md絶対原則10）。
# 各値の取得方法は docs/manual-setup.md を参照。

NODE_ENV=production

# 認証
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nestio.niwatorimc.com/api/v1/auth/google/callback
SESSION_SECRET=
APP_ORIGIN=https://nestio.niwatorimc.com

# 通知
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Hatch
# CLAUDE_BIN/CLAUDE_WORKDIR/CLAUDE_TIMEOUT_SECはdocker/Dockerfile側で既定値を設定済みのため
# 通常はここで上書き不要。ANTHROPIC_API_KEYだけは秘密情報のため必ずここで設定する
# （console.anthropic.com で発行。docs/manual-setup.md D-1参照）
ANTHROPIC_API_KEY=
HATCH_SCRIPTS=
DISCORD_WEBHOOKS=

# 保持期間
TOMBSTONE_RETENTION_DAYS=30

# ログ
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# レート制限（1分あたりのリクエスト数）
RATE_LIMIT_SYNC=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_MCP=60
RATE_LIMIT_ATTACHMENT=60
RATE_LIMIT_CLIENT_LOGS=30

# DB_PATH / ATTACHMENT_DIR / LOG_DIR / WEB_DIST_DIR / PORT は
# docker/Dockerfile 側で本番用の既定値を設定済みのため、通常はここで上書き不要
