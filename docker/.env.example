# docker-compose.yml の env_file として読み込む本番用の環境変数。
# コピーして .env を作り、実際の値を埋める（.env はコミットしない。CLAUDE.md絶対原則10）。
# 各値の取得方法は docs/manual-setup.md を参照。

NODE_ENV=production

# 認証
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://nestio.niwatorimc.com/api/v1/auth/google/callback
SESSION_SECRET=
APP_ORIGIN=https://nestio.niwatorimc.com

# 通知
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Hatch
# CLAUDE_BIN/CLAUDE_WORKDIR/CLAUDE_TIMEOUT_SEC/HOMEはdocker/Dockerfile側で既定値を設定済みのため
# 通常はここで上書き不要。認証はAPIキーではなくclaude CLIへのログイン（サブスクリプション経由、
# 要件定義のbudget: Claude API課金なしに従う）。`docker compose exec -it nestio claude`で
# 一度だけ対話ログインする（docs/manual-setup.md D-1）。ANTHROPIC_API_KEYは設定しないこと
HATCH_SCRIPTS=
DISCORD_WEBHOOKS=

# 保持期間
TOMBSTONE_RETENTION_DAYS=30

# ログ
LOG_LEVEL=info
LOG_RETENTION_DAYS=14

# レート制限（1分あたりのリクエスト数）
RATE_LIMIT_SYNC=120
RATE_LIMIT_AUTH=20
RATE_LIMIT_MCP=60
RATE_LIMIT_ATTACHMENT=60
RATE_LIMIT_CLIENT_LOGS=30

# DB_PATH / ATTACHMENT_DIR / LOG_DIR / WEB_DIST_DIR / PORT は
# docker/Dockerfile 側で本番用の既定値を設定済みのため、通常はここで上書き不要

# 添付ファイルの保存時暗号化（任意・改修5回目）。設定するとAES-256-GCMで暗号化してディスクへ保存する。
# 復号はAES-NI/ARM Crypto Extensionsによりハードウェア支援されるため読み込み速度への影響は軽微。
# 生成例: openssl rand -base64 32
# 未設定なら従来通り平文保存（設定後に有効化しても、それより前の既存添付は平文のまま残る）
ATTACHMENT_ENCRYPTION_KEY=
