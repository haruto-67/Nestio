{
  "name": "nestio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nestio/shared run build && pnpm --parallel --filter ./apps/* --filter @nestio/shared run dev",
    "build": "pnpm --recursive --filter ./apps/* --filter ./packages/* run build",
    "test": "pnpm --recursive run test",
    "test:e2e": "pnpm --filter @nestio/web run test:e2e",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "pnpm --filter @nestio/api run migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  }
}
